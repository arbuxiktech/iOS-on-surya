diff --git a/bsd/dev/sweet_board.h b/bsd/dev/sweet_board.h
--- a/bsd/dev/sweet_board.h
+++ b/bsd/dev/sweet_board.h
@@ -1,6 +1,7 @@
 /*
- * SWEET kernels run on two Xiaomi phones. The ADT root compatible
- * (tools/mkadt.py --board) names the board; everything else is common.
+ * SWEET kernels support several Xiaomi platforms. The ADT root compatible
+ * (tools/mkadt.py --board) names the board; drivers gate board-specific paths.
  *   xiaomi,sweet      Redmi Note 10 Pro, SM7150 (default)
+ *   xiaomi,surya      Poco X3 NFC, SM7150
  *   xiaomi,beryllium  Poco F1, SDM845
@@ -41,11 +42,22 @@ sweet_board_beryllium(void)
 static inline bool
 sweet_board_beryllium(void)
 {
 	static int cached = -1;
 	if (cached < 0) {
 		cached = sweet_board_is("xiaomi,beryllium") ? 1 : 0;
 	}
 	return cached == 1;
 }
 
+static inline bool
+sweet_board_surya(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		cached = sweet_board_is("xiaomi,surya") ? 1 : 0;
+	}
+	return cached == 1;
+}
+
 #endif /* _SWEET_BOARD_H_ */
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -987,3 +987,8 @@ sweet_touch_init(void)
 	}
 	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
 	(void)PE_parse_boot_argn("sweettouchirq", &st.irq_hint, sizeof(st.irq_hint));
+	if (sweet_board_surya()) {
+		/* Surya's Novatek nt36xxx touchscreen uses SPI; the legacy driver probes unrelated I2C. */
+		printf("SWEET TOUCH: surya nt36xxx SPI driver not ported; skipped\n");
+		return;
+	}
