+	    name, initial.a[0], arginfo, initial.a[2], arg1, arg2);
+	sweet_log_sync();
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bool done = scm_invoke(&initial, false, &r);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET SURYA GPU: SCM PAS %s completed=%u status=%d result=%d\n", name, done, (int32_t)r.a[0], (int32_t)r.a[1]);
