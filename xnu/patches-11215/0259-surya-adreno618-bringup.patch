+static void
+surya_gpu_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	int wait = 600;
+	(void)PE_parse_boot_argn("sweetgpuwait", &wait, sizeof(wait));
+	/* Stages >= 3 need the firmware: the ADT, or the iOS root once it is mounted. */
+	void *fw = NULL;
+	size_t size = 0;
+	for (int t = 0;; t += 2) {
+		if (sweet_surya_gpu_fw_get("gmu-firmware", "a618_gmu.bin", &fw, &size)) {
+			sweet_surya_gpu_fw_put(fw, size);
+			break;
+		}
+		if (t == 0 || t % 60 == 0) {
+			printf("SWEET SURYA GPU: waiting for a618_gmu.bin (ADT /sweet-gpu or %s), %d s\n", FW_DIR, t);
+		}
+		if (t >= wait) {
+			printf("SWEET SURYA GPU: no GPU firmware after %d s; giving up (see docs/SURYA_PORT.md)\n", t);
+			goto out;
+		}
+		sleep_ms(2000);
+	}
+	sleep_ms(3000);         /* let the root file system settle before the GPU work starts */
+	surya_gpu_run(surya_mode);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_surya_gpu_probe(void)
+{
+	int mode = 0;
+	thread_t thread;
+
+	if (!sweet_board_surya()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetgpu", &mode, sizeof(mode));
+	if (mode <= 0) {
+		return;
+	}
+	if (mode > 6) {
+		printf("SWEET SURYA GPU: stages above 6 are not enabled\n");
+		mode = 6;
+	}
+	surya_mode = mode;
+	if (mode <= 2) {
+		surya_gpu_run(mode);         /* no firmware, no waiting */
+		return;
+	}
+	kern_return_t kr = kernel_thread_start((thread_continue_t)surya_gpu_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET SURYA GPU: kernel_thread_start failed %d\n", kr);
+	}
+}
