--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -673,6 +673,22 @@ sweet_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __
 	return 0;
 }
 
+
+/* Read-only diagnostics: never trace logger writes back into the logger. */
+extern int sweet_init_trace_enabled(void);
+extern void sweet_init_exec_trace(const char *stage, int result);
+static void
+sweet_ufs_init_trace(const char *stage, uint64_t off, uint32_t count, int result)
+{
+	char label[96];
+	if (!sweet_init_trace_enabled()) {
+		return;
+	}
+	snprintf(label, sizeof(label), "UFS %s off=0x%llx n=%u", stage,
+	    (unsigned long long)off, count);
+	sweet_init_exec_trace(label, result);
+}
+
 static void
 sweet_ufs_strategy(buf_t bp)
 {
@@ -686,6 +702,7 @@ sweet_ufs_strategy(buf_t bp)
 	bool fua = !rd && (su.fua >= 1) && (buf_flags(bp) & B_FUA);
 
 	if (rd) {
+		sweet_ufs_init_trace("request", off, count, 0);
 		ss.strat_reads++;
 	} else {
 		ss.strat_writes++;
@@ -702,12 +719,15 @@ sweet_ufs_strategy(buf_t bp)
 	if (count == 0) {
 		goto done;
 	}
+	if (rd) sweet_ufs_init_trace("map begin", off, count, 0);
 	if (buf_map(bp, &vaddr)) {
 		error = EIO;
 		goto done;
 	}
 
+	if (rd) sweet_ufs_init_trace("lock begin", off, count, 0);
 	lck_mtx_lock(&sweet_ufs_lock);
+	if (rd) sweet_ufs_init_trace("lock acquired", off, count, 0);
 	for (uint32_t done = 0; done < count;) {
 		uint64_t pos = off + done;
 		uint64_t lba = pos / UFS_BLOCK;
@@ -716,7 +736,9 @@ sweet_ufs_strategy(buf_t bp)
 		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
 		void *bounce = (void *)(su.dma + DMA_BOUNCE);
 		if (rd) {
+			sweet_ufs_init_trace("read begin", lba * UFS_BLOCK, blocks * UFS_BLOCK, 0);
 			error = ufs_read_blocks(su.first_block + lba, blocks);
+			sweet_ufs_init_trace("read done", lba * UFS_BLOCK, blocks * UFS_BLOCK, error);
 			if (!error) {
 				memcpy(vaddr + done, (const char *)bounce + skip, want);
 			}
@@ -738,6 +760,16 @@ sweet_ufs_strategy(buf_t bp)
 		buf_setresid(bp, count - done);
 	}
 	lck_mtx_unlock(&sweet_ufs_lock);
+	if (rd && !error && sweet_init_trace_enabled()) {
+		uint32_t hash = 2166136261U;
+		char label[96];
+		for (uint32_t i = 0; i < MIN(count, 4096U); i++) {
+			hash = (hash ^ (uint8_t)vaddr[i]) * 16777619U;
+		}
+		snprintf(label, sizeof(label), "UFS data off=0x%llx n=%u fnv=%08x",
+		    (unsigned long long)off, count, hash);
+		sweet_init_exec_trace(label, 0);
+	}
 	buf_unmap(bp);
 
 done:
@@ -749,6 +781,7 @@ done:
 			    rd ? "read" : "write", (long long)buf_blkno(bp), count, error, buf_resid(bp));
 		}
 	}
+	if (rd) sweet_ufs_init_trace("complete", off, count, error);
 	buf_biodone(bp);
 }
 
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index eb46148..af983ed 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -194,23 +194,30 @@ void sweet_exec_delay(const char *leaf);
 /* Opt-in PID 1 exec checkpoints for Surya bring-up; no change to exec policy.
  * Keep output bounded if launchd subsequently spawns many children. */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
+int sweet_init_trace_enabled(void);
 void sweet_init_exec_trace(const char *stage, int result);
 
-void
-sweet_init_exec_trace(const char *stage, int result)
+int
+sweet_init_trace_enabled(void)
 {
 	static int enabled = -1;
-	static unsigned int sequence;
 
 	if (proc_getpid(current_proc()) != 1) {
-		return;
+		return 0;
 	}
 	if (enabled < 0) {
 		int on = 0;
 		PE_parse_boot_argn("sweetinittrace", &on, sizeof(on));
 		enabled = on != 0;
 	}
-	if (enabled && sequence < 256) {
+	return enabled;
+}
+
+void
+sweet_init_exec_trace(const char *stage, int result)
+{
+	static unsigned int sequence;
+	if (sweet_init_trace_enabled() && sequence < 512) {
 		printf("INIT %u: %s rc=%d\n", ++sequence, stage, result);
 	}
 }
