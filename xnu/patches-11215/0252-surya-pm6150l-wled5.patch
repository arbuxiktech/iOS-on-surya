+/* PM6150L WLED5 (Surya), matched to the live FDT's SID 5 / d800+d900 blocks. */
+#define SWEET_WLED5_CTRL_EN       0xd846u
+#define SWEET_WLED5_MOD_A_EN      0xd950u
+#define SWEET_WLED5_MOD_B_EN      0xd960u
+#define SWEET_WLED5_MOD_A_WIDTH   0xd952u
+#define SWEET_WLED5_MOD_B_WIDTH   0xd962u
+#define SWEET_WLED5_MOD_A_BRIGHT  0xd953u
+#define SWEET_WLED5_MOD_B_BRIGHT  0xd963u
+#define SWEET_WLED5_SYNC          0xd965u
+#define SWEET_WLED5_ENABLE_MASK   0x80u
+#define SWEET_WLED5_SYNC_A        0x01u
+#define SWEET_WLED5_SYNC_B        0x02u
+
+static unsigned sweet_wled5_module = 2; /* 0 = A, 1 = B; 2 = not identified */
+static unsigned sweet_wled5_brightness_addr;
+
+static int
+sweet_wled5_read16(uint16_t *out)
+{
+	uint8_t lo, hi;
+	if (sweet_wled5_module > 1 || out == NULL ||
+	    sweet_spmi_read(5, sweet_wled5_brightness_addr, &lo) != 0 ||
+	    sweet_spmi_read(5, sweet_wled5_brightness_addr + 1, &hi) != 0) {
+		return -1;
+	}
+	*out = (uint16_t)(lo | ((uint16_t)hi << 8));
+	return 0;
+}
+
+static int
+sweet_wled5_sync(void)
+{
+	uint8_t clear = 0;
+	uint8_t set = sweet_wled5_module == 0 ? SWEET_WLED5_SYNC_A : SWEET_WLED5_SYNC_B;
+	uint8_t old;
+	if (sweet_spmi_read(5, SWEET_WLED5_SYNC, &old) != 0) {
+		return -1;
+	}
+	clear = (uint8_t)(old & ~0x03u);
+	set = (uint8_t)(clear | (sweet_wled5_module == 0 ? SWEET_WLED5_SYNC_A : SWEET_WLED5_SYNC_B));
+	return sweet_spmi_write(5, SWEET_WLED5_SYNC, &clear, 1) == 0 &&
+	    sweet_spmi_write(5, SWEET_WLED5_SYNC, &set, 1) == 0 ? 0 : -1;
+}
+
+/* Preserve all control bits except the WLED module enable bit (PM6150L WLED5). */
+static int
+sweet_wled5_set_enabled(bool enabled)
+{
+	uint8_t old, want, got;
+	if (sweet_spmi_read(5, SWEET_WLED5_CTRL_EN, &old) != 0) {
+		return -1;
+	}
+	want = (uint8_t)((old & (uint8_t)~SWEET_WLED5_ENABLE_MASK) |
+	    (enabled ? SWEET_WLED5_ENABLE_MASK : 0));
+	if (want != old && sweet_spmi_write(5, SWEET_WLED5_CTRL_EN, &want, 1) != 0) {
+		return -1;
+	}
+	return sweet_spmi_read(5, SWEET_WLED5_CTRL_EN, &got) == 0 &&
+	    ((got ^ want) & SWEET_WLED5_ENABLE_MASK) == 0 ? 0 : -1;
+}
