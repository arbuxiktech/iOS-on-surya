--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -689,6 +689,26 @@ sweet_ufs_init_trace(const char *stage, uint64_t off, uint32_t count, int result
 	sweet_init_exec_trace(label, result);
 }
 
+
+/* Observe the source without modifying it or the original memcpy. */
+static void
+sweet_ufs_copy_trace(const char *src, char *dst, uint32_t count)
+{
+	char label[96];
+	uint32_t hash = 2166136261U;
+	if (!sweet_init_trace_enabled()) {
+		return;
+	}
+	snprintf(label, sizeof(label), "UFS copy dst=0x%llx src=0x%llx n=%u",
+	    (unsigned long long)(uintptr_t)dst, (unsigned long long)(uintptr_t)src, count);
+	sweet_init_exec_trace(label, 0);
+	for (uint32_t i = 0; i < MIN(count, 4096U); i++) {
+		hash = (hash ^ (uint8_t)src[i]) * 16777619U;
+	}
+	snprintf(label, sizeof(label), "UFS copy source fnv=%08x", hash);
+	sweet_init_exec_trace(label, 0);
+}
