+/*
+ * Surya Poco X3 NFC Novatek NT36672C SPI touchscreen for XNU.
+ *
+ * Hardware data: user-provided live FDT (QUP0 SE0 at 0x880000, CS0, 8 MHz,
+ * reset GPIO 8, IRQ GPIO 9), Xiaomi's sm7150/Atoll pinctrl and GCC sources,
+ * and the Surya downstream NT36xxx SPI driver. The selected Tianma panel uses
+ * the NT36672A-family event map and two-byte hardware-CRC length registers.
+ *
+ * All actions are staged and off by default. Stage 1 only reads TLMM; stage 2
+ * reads GENI/GCC; stage 3 enables QUP0 clocks and applies the four QUP00 pad
+ * settings; stage 4 performs the documented Novatek software bootloader reset
+ * and trim-ID read; stage 5 requires sweettouchfw=1 and downloads the optional
+ * firmware property to controller SRAM, then polls reports. The shared L18A
+ * touchscreen/panel rail is enabled only in stages 3-5 and left on. The reset
+ * and IRQ pads use the Surya pinctrl settings; GPIO8 follows Xiaomi's sequence
+ * (drive low, engine reset, drive high) before the trim probe.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include "sweet_board.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern int sweet_rpmh_vreg_set(const char *res, unsigned mv, bool enable);
+
+#define SURYA_TOUCH_SE_PA       0x00880000u
+#define SURYA_TOUCH_GCC_PA      0x00100000u
+#define SURYA_TOUCH_TLMM_PA     0x03900000u
+#define SURYA_TOUCH_TLMM_SIZE   0x0005b000u
+#define SURYA_TOUCH_GCC_SIZE    0x00060000u
+#define SURYA_TOUCH_SE_SIZE     0x00004000u
+
+#define SURYA_GPIO_CFG(n)       ((uint32_t)(n) * 0x1000u)
+#define SURYA_GPIO_IO(n)        (SURYA_GPIO_CFG(n) + 4u)
+#define SURYA_GPIO_PULL_UP      3u
+#define SURYA_GPIO_DRIVE_16MA   7u
+#define SURYA_GPIO_OUTPUT_EN    (1u << 9)
+#define SURYA_GPIO_OUTPUT       (1u << 0)
+#define SURYA_GPIO_INPUT        (1u << 1)
+#define SURYA_TOUCH_RESET_GPIO  8u
+#define SURYA_TOUCH_IRQ_GPIO    9u
+#define SURYA_TOUCH_SPI_FIRST   49u
+#define SURYA_TOUCH_SPI_LAST    52u
+#define SURYA_TOUCH_MUX_QUP00   2u
+#define SURYA_TOUCH_DRIVE_6MA   2u
+#define SURYA_TOUCH_WIDTH       1080u
+#define SURYA_TOUCH_HEIGHT      2400u
+#define SURYA_TOUCH_FINGERS     10u
+
+/* GCC SM7150 QUPv3 wrapper 0 clock tree, from gcc-sdmmagpie.c. */
+#define TOUCH_GCC_VOTE          0x5200cu
+#define TOUCH_GCC_VOTE_MASK     ((1u << 6) | (1u << 7) | (1u << 8) | \
+                                 (1u << 9) | (1u << 10))
+#define TOUCH_GCC_SE0_RCG       0x17034u
+
+/* GENI SE and SPI registers, from Linux qcom-geni-se/spi-geni. */
+#define SE_GENI_OUTPUT_CTRL     0x024u
+#define SE_GENI_CGC_CTRL        0x028u
+#define SE_GENI_STATUS          0x040u
+#define SE_GENI_M_CLK_CFG       0x048u
+#define SE_GENI_IF_FIFO_DISABLE 0x064u
+#define SE_GENI_FW_REVISION     0x068u
+#define SE_GENI_CLK_SEL         0x07cu
+#define SE_GENI_FORCE_DEFAULT   0x020u
+#define SE_GENI_DMA_MODE_EN     0x258u
+#define SE_GENI_TX_PACKING_CFG0 0x260u
+#define SE_GENI_TX_PACKING_CFG1 0x264u
+#define SE_SPI_TX_TRANS_LEN     0x26cu
+#define SE_SPI_RX_TRANS_LEN     0x270u
+#define SE_SPI_CPHA             0x224u
+#define SE_SPI_LOOPBACK         0x22cu
+#define SE_SPI_CPOL             0x230u
+#define SE_SPI_DEMUX_OUTPUT_INV 0x24cu
+#define SE_SPI_DEMUX_SEL        0x250u
+#define SE_SPI_TRANS_CFG        0x25cu
+#define SE_SPI_WORD_LEN         0x268u
+#define SE_GENI_M_CMD0           0x600u
+#define SE_GENI_M_CMD_CTRL      0x604u
+#define SE_GENI_M_IRQ_STATUS    0x610u
+#define SE_GENI_M_IRQ_EN        0x614u
+#define SE_GENI_M_IRQ_CLEAR     0x618u
+#define SE_GENI_TX_FIFO         0x700u
+#define SE_GENI_RX_FIFO         0x780u
+#define SE_GENI_TX_FIFO_STATUS  0x800u
+#define SE_GENI_RX_FIFO_STATUS  0x804u
+#define SE_GENI_TX_WATERMARK    0x80cu
+#define SE_GENI_RX_WATERMARK    0x810u
+#define SE_GENI_RX_RFR_WM       0x814u
+#define SE_GSI_EVENT_EN         0xe18u
+#define SE_IRQ_EN               0xe1cu
+#define SE_GENI_HW_PARAM_0      0xe24u
+#define SE_GENI_HW_PARAM_1      0xe28u
+#define SE_GENI_TX_RX_PACKING0  0x284u
+#define SE_GENI_TX_RX_PACKING1  0x288u
+
+#define SE_PROTO_SPI            1u
+#define SE_SPI_TX_ONLY_OPCODE   1u /* Linux SPI_TX_ONLY, M_CMD0[31:27] */
+#define SE_SPI_FULL_DUPLEX_OPCODE 3u /* Linux uses FULL_DUPLEX when TX and RX buffers are present */
+#define SE_M_DONE               (1u << 0)
+#define SE_M_ERRORS             (0x3eu | (3u << 24) | (3u << 28))
+#define SE_M_EVENTS             (SE_M_DONE | SE_M_ERRORS)
+#define SE_FIFO_WORD_COUNT(v)   ((v) & 0x1fu)
+#define SE_OPCODE_SHIFT         27u
+#define SE_PACK_8BIT_4BYTE_0    0x0007f8feu
+#define SE_PACK_8BIT_4BYTE_1    0x000ffefeu
+
+/* NT36672C on Surya follows Xiaomi's NT36672A-family register map. */
+#define NVT_SWRST_N8_ADDR       0x03f0feu
+#define NVT_ENG_RST_ADDR        0x7fff80u
+#define NVT_SPI_RD_FAST_ADDR    0x03f310u
+#define NVT_TRIM_ID_ADDR        0x01f64eu
+#define NVT_TRIM_ID_LEN         6u
+#define NVT_EVENT_BUF_ADDR      0x021c00u
+#define NVT_EVENT_RESET         0x60u
+#define NVT_EVENT_HOST_CMD      0x50u
+#define NVT_BOOT_READY_ADDR     0x03f10du
+#define NVT_BLD_CRC_EN_ADDR     0x03f30eu
+#define NVT_ILM_DES_ADDR        0x03f128u
+#define NVT_ILM_LENGTH_ADDR     0x03f118u
+#define NVT_ILM_GCRC_ADDR       0x03f100u
+#define NVT_DLM_DES_ADDR        0x03f12cu
+#define NVT_DLM_LENGTH_ADDR     0x03f130u
+#define NVT_DLM_GCRC_ADDR       0x03f104u
+#define NVT_RESET_STATE_INIT    0xa0u
+#define NVT_RESET_STATE_MAX     0xafu
+#define NVT_REPORT_BYTES        65u
+#define NVT_FW_SECTOR           4096u
+#define NVT_FW_CHUNK            4096u
+#define NVT_FW_MAX_SIZE         (2u * 1024u * 1024u)
+#define NVT_MAX_PARTITIONS      32u
+#define NVT_SPI_READ(a)         ((uint8_t)((a) & 0x7fu))
+#define NVT_SPI_WRITE(a)        ((uint8_t)(((a) & 0x7fu) | 0x80u))
+
+struct nvt_partition {
+	uint32_t bin, sram, size, crc;
+};
+
+static struct {
+	vm_offset_t se, gcc, tlmm;
+	bool started, dead;
+	unsigned stage, fifo_words, clk_sel, divider;
+	unsigned active_count;
+	uint32_t active_mask;
+	int x[SURYA_TOUCH_FINGERS], y[SURYA_TOUCH_FINGERS];
+} st;
+
+static int surya_touch_sleep_chan;
+static uint8_t spi_tx[NVT_FW_CHUNK + 2u];
+static uint8_t spi_rx[NVT_FW_CHUNK + 2u];
+static uint8_t fw_chunk[NVT_FW_CHUNK + 1u];
+static struct nvt_partition fw_parts[NVT_MAX_PARTITIONS];
+static unsigned fw_nparts;
+static size_t fw_image_size;
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__sync_synchronize();
+}
+
+static void
+touch_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&surya_touch_sleep_chan, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(touch_rd(base, off) & mask))
+			return true;
+		delay(1);
+	}
+	return false;
+}
+
+static void
+touch_dump_pins(void)
+{
+	for (unsigned pin = SURYA_TOUCH_RESET_GPIO; pin <= SURYA_TOUCH_IRQ_GPIO; ++pin) {
+		printf("SWEET SURYA TOUCH: GPIO%u cfg=%#x io=%#x\n", pin,
+		    touch_rd(st.tlmm, SURYA_GPIO_CFG(pin)),
+		    touch_rd(st.tlmm, SURYA_GPIO_IO(pin)));
+	}
+	for (unsigned pin = SURYA_TOUCH_SPI_FIRST; pin <= SURYA_TOUCH_SPI_LAST; ++pin) {
+		printf("SWEET SURYA TOUCH: GPIO%u cfg=%#x io=%#x\n", pin,
+		    touch_rd(st.tlmm, SURYA_GPIO_CFG(pin)),
+		    touch_rd(st.tlmm, SURYA_GPIO_IO(pin)));
+	}
+}
+
+/* Match Xiaomi's TLMM states: GPIO9 input/pull-up; GPIO8 output, initially low. */
+static void
+touch_gpio_input(unsigned gpio)
+{
+	uint32_t off = SURYA_GPIO_CFG(gpio);
+	uint32_t cfg = touch_rd(st.tlmm, off);
+	cfg &= ~0x3ffu;
+	cfg |= SURYA_GPIO_PULL_UP | (SURYA_GPIO_DRIVE_16MA << 6);
+	touch_wr(st.tlmm, off, cfg);
+}
+
+static void
+touch_gpio_output(unsigned gpio, bool high)
+{
+	uint32_t off = SURYA_GPIO_CFG(gpio);
+	uint32_t io = touch_rd(st.tlmm, SURYA_GPIO_IO(gpio));
+	uint32_t cfg = touch_rd(st.tlmm, off);
+	io = high ? (io | SURYA_GPIO_OUTPUT) : (io & ~SURYA_GPIO_OUTPUT);
+	touch_wr(st.tlmm, SURYA_GPIO_IO(gpio), io);
+	cfg &= ~0x3ffu;
+	cfg |= SURYA_GPIO_PULL_UP | (SURYA_GPIO_DRIVE_16MA << 6) |
+	    SURYA_GPIO_OUTPUT_EN;
+	touch_wr(st.tlmm, off, cfg);
+}
+
+static void
+touch_gpio_prepare(void)
+{
+	touch_gpio_output(SURYA_TOUCH_RESET_GPIO, false);
+	touch_gpio_input(SURYA_TOUCH_IRQ_GPIO);
+	printf("SWEET SURYA TOUCH: GPIO8 output-low, GPIO9 input/pull-up state=%u\n",
+	    (touch_rd(st.tlmm, SURYA_GPIO_IO(SURYA_TOUCH_IRQ_GPIO)) & SURYA_GPIO_INPUT) != 0);
+}
+
+/* Set only SPI0 pads identified by Surya's active QUP00 pinctrl group. */
+static void
+touch_spi_pins(void)
+{
+	for (unsigned pin = SURYA_TOUCH_SPI_FIRST; pin <= SURYA_TOUCH_SPI_LAST; ++pin) {
+		uint32_t off = SURYA_GPIO_CFG(pin);
+		uint32_t cfg = touch_rd(st.tlmm, off);
+		cfg &= ~0x3ffu;
+		cfg |= (SURYA_TOUCH_MUX_QUP00 << 2) | (SURYA_TOUCH_DRIVE_6MA << 6);
+		touch_wr(st.tlmm, off, cfg); /* function qup00, 6 mA, no pull */
+	}
+}
+
+/* Enable only QUP0 AHB/core/SE0 votes and select the XO/1 reference. */
+static int
+touch_gcc_enable(void)
+{
+	static const uint32_t branches[] = { 0x17004u, 0x17008u, 0x1700cu,
+	    0x17014u, 0x17030u };
+	uint32_t old = touch_rd(st.gcc, TOUCH_GCC_VOTE);
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, old | TOUCH_GCC_VOTE_MASK);
+
+	uint32_t dfs = touch_rd(st.gcc, TOUCH_GCC_SE0_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, TOUCH_GCC_SE0_RCG + 4u);
+	int level = -1;
+	if (dfs & 1u) {
+		for (unsigned i = 0; i < 8; ++i) {
+			uint32_t v = touch_rd(st.gcc, TOUCH_GCC_SE0_RCG + 0x1cu + 4u * i);
+			if (level < 0 && (v & 0x371fu) == 1u)
+				level = (int)i;
+		}
+		if (level < 0) {
+			printf("SWEET SURYA TOUCH: no XO/1 DFS level; clock source unchanged\n");
+			return -1;
+		}
+	} else {
+		/* QUP0 S0 source: parent 0 is 19.2 MHz TCXO, HID divider 1. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, TOUCH_GCC_SE0_RCG + 4u, cfg);
+		touch_wr(st.gcc, TOUCH_GCC_SE0_RCG,
+		    touch_rd(st.gcc, TOUCH_GCC_SE0_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, TOUCH_GCC_SE0_RCG, 1u)) {
+			printf("SWEET SURYA TOUCH: QUP0 SE0 RCG update timed out\n");
+			return -1;
+		}
+		level = 0;
+	}
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		uint32_t v = touch_rd(st.gcc, branches[i]);
+		/* HWCG branches can show CLK_OFF while idle; Linux skips that check. */
+		if (v & 2u)
+			continue;
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("SWEET SURYA TOUCH: GCC branch %#x still halted (%#x)\n",
+			    branches[i], touch_rd(st.gcc, branches[i]));
+			return -1;
+		}
+	}
+	st.clk_sel = (unsigned)level;
+	printf("SWEET SURYA TOUCH: QUP0 SE0 GCC clocks enabled, DFS level %u, vote=%#x\n",
+	    st.clk_sel, touch_rd(st.gcc, TOUCH_GCC_VOTE));
+	return 0;
+}
+
+static bool
+touch_spi_init(void)
+{
+	uint32_t hw0 = touch_rd(st.se, SE_GENI_HW_PARAM_0);
+	uint32_t hw1 = touch_rd(st.se, SE_GENI_HW_PARAM_1);
+	uint32_t fw = touch_rd(st.se, SE_GENI_FW_REVISION);
+	uint32_t width = (hw0 >> 24) & 0x3fu;
+	uint32_t depth = (hw0 >> 16) & 0x3fu;
+	uint32_t rx_width = (hw1 >> 24) & 0x3fu;
+	uint32_t rx_depth = (hw1 >> 16) & 0x3fu;
+	if (touch_rd(st.se, SE_GENI_IF_FIFO_DISABLE) & 1u) {
+		printf("SWEET SURYA TOUCH: SE0 FIFO interface disabled; GSI/DMA path not ported\n");
+		return false;
+	}
+	if (((fw >> 8) & 0xffu) != SE_PROTO_SPI || width != 32 ||
+	    rx_width != 32 || depth < 4 || depth > 31 || rx_depth < 4 || rx_depth > 31) {
+		printf("SWEET SURYA TOUCH: SE0 not ready for SPI fw=%#x hw=%#x/%#x\n",
+		    fw, hw0, hw1);
+		return false;
+	}
+	if (touch_rd(st.se, SE_GENI_STATUS) & 1u) {
+		printf("SWEET SURYA TOUCH: SE0 already busy; no takeover\n");
+		return false;
+	}
+	st.fifo_words = depth;
+	st.divider = 4;
+	(void)PE_parse_boot_argn("sweettouchdiv", &st.divider, sizeof(st.divider));
+	if (st.divider < 2 || st.divider > 16) {
+		printf("SWEET SURYA TOUCH: sweettouchdiv=%u outside 2..16\n", st.divider);
+		return false;
+	}
+
+	touch_wr(st.se, SE_GENI_CGC_CTRL, touch_rd(st.se, SE_GENI_CGC_CTRL) | 0x7fu);
+	touch_wr(st.se, SE_GENI_DMA_MODE_EN, 0);
+	touch_wr(st.se, SE_GSI_EVENT_EN, 0);
+	touch_wr(st.se, SE_IRQ_EN, 0);
+	touch_wr(st.se, SE_GENI_M_IRQ_EN, 0);
+	touch_wr(st.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	touch_wr(st.se, SE_GENI_OUTPUT_CTRL, 0x7fu);
+	touch_wr(st.se, SE_GENI_FORCE_DEFAULT, 1);
+	touch_wr(st.se, SE_GENI_CLK_SEL, st.clk_sel);
+	touch_wr(st.se, SE_GENI_M_CLK_CFG, ((st.divider & 0xffu) << 4) | 1u);
+	touch_wr(st.se, SE_SPI_LOOPBACK, 0);
+	touch_wr(st.se, SE_SPI_CPHA, 0);
+	touch_wr(st.se, SE_SPI_CPOL, 0);
+	touch_wr(st.se, SE_SPI_DEMUX_OUTPUT_INV, 0);
+	touch_wr(st.se, SE_SPI_DEMUX_SEL, 0); /* chip select 0 */
+	touch_wr(st.se, SE_SPI_TRANS_CFG, 0);
+	touch_wr(st.se, SE_SPI_WORD_LEN, 4); /* 8 bits minus GENI's 4-bit minimum */
+	touch_wr(st.se, SE_GENI_TX_PACKING_CFG0, SE_PACK_8BIT_4BYTE_0);
+	touch_wr(st.se, SE_GENI_TX_PACKING_CFG1, SE_PACK_8BIT_4BYTE_1);
+	touch_wr(st.se, SE_GENI_TX_RX_PACKING0, SE_PACK_8BIT_4BYTE_0);
+	touch_wr(st.se, SE_GENI_TX_RX_PACKING1, SE_PACK_8BIT_4BYTE_1);
+	touch_wr(st.se, SE_GENI_TX_WATERMARK, 1);
+	touch_wr(st.se, SE_GENI_RX_WATERMARK, 0);
+	touch_wr(st.se, SE_GENI_RX_RFR_WM, rx_depth - 2u);
+	touch_wr(st.se, SE_GENI_M_IRQ_EN, SE_M_EVENTS);
+	printf("SWEET SURYA TOUCH: SPI configured div=%u clk-sel=%u FIFO=%u/%u word=%#x\n",
+	    st.divider, st.clk_sel, depth, rx_depth, touch_rd(st.se, SE_SPI_WORD_LEN));
+	return true;
+}
+
+/* FIFO-polled SPI transfer. A non-NULL RX buffer selects full duplex. */
+static int
+touch_spi_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	size_t sent = 0, received = 0;
+	bool done = false;
+	if (st.dead || !tx || len == 0 || len > sizeof(spi_tx))
+		return EINVAL;
+	if (!touch_wait_clear(st.se, SE_GENI_STATUS, 1u))
+		return EBUSY;
+	for (unsigned i = 0; i < 64 && SE_FIFO_WORD_COUNT(touch_rd(st.se,
+	    SE_GENI_RX_FIFO_STATUS)); ++i)
+		(void)touch_rd(st.se, SE_GENI_RX_FIFO);
+	touch_wr(st.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	touch_wr(st.se, SE_SPI_TX_TRANS_LEN, (uint32_t)len);
+	if (rx) {
+		touch_wr(st.se, SE_SPI_RX_TRANS_LEN, (uint32_t)len);
+		touch_wr(st.se, SE_GENI_M_CMD0,
+		    SE_SPI_FULL_DUPLEX_OPCODE << SE_OPCODE_SHIFT);
+	} else {
+		touch_wr(st.se, SE_GENI_M_CMD0, SE_SPI_TX_ONLY_OPCODE << SE_OPCODE_SHIFT);
+	}
+
+	for (unsigned spin = 0; spin < 20000; ++spin) {
+		while (sent < len &&
+		    SE_FIFO_WORD_COUNT(touch_rd(st.se, SE_GENI_TX_FIFO_STATUS)) < st.fifo_words - 1u) {
+			uint32_t word = 0;
+			for (unsigned b = 0; b < 4 && sent < len; ++b, ++sent)
+				word |= (uint32_t)tx[sent] << (8u * b);
+			touch_wr(st.se, SE_GENI_TX_FIFO, word);
+		}
+		if (rx) {
+			uint32_t words = SE_FIFO_WORD_COUNT(touch_rd(st.se, SE_GENI_RX_FIFO_STATUS));
+			while (words-- && received < len) {
+				uint32_t word = touch_rd(st.se, SE_GENI_RX_FIFO);
+				for (unsigned b = 0; b < 4 && received < len; ++b, ++received)
+					rx[received] = (uint8_t)(word >> (8u * b));
+			}
+		}
+		uint32_t irq = touch_rd(st.se, SE_GENI_M_IRQ_STATUS);
+		if (irq & SE_M_ERRORS) {
+			touch_wr(st.se, SE_GENI_M_IRQ_CLEAR, irq);
+			touch_wr(st.se, SE_GENI_M_CMD_CTRL, 2);
+			printf("SWEET SURYA TOUCH: SPI error irq=%#x sent=%u rx=%u\n",
+			    irq, (unsigned)sent, (unsigned)received);
+			return EIO;
+		}
+		if (irq & SE_M_DONE) {
+			done = true;
+			touch_wr(st.se, SE_GENI_M_IRQ_CLEAR, irq);
+		}
+		if (done && sent == len && (!rx || received == len))
+			return 0;
+		delay(1);
+	}
+	touch_wr(st.se, SE_GENI_M_CMD_CTRL, 2);
+	if (!touch_wait_clear(st.se, SE_GENI_STATUS, 1u))
+		st.dead = true;
+	touch_wr(st.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	printf("SWEET SURYA TOUCH: SPI timeout done=%u sent=%u rx=%u status=%#x\n",
+	    done, (unsigned)sent, (unsigned)received, touch_rd(st.se, SE_GENI_STATUS));
+	return ETIMEDOUT;
+}
+
+static int
+nvt_write_raw(uint32_t addr, const uint8_t *data, size_t len)
+{
+	if (len + 1u > sizeof(spi_tx) || (!data && len))
+		return EINVAL;
+	spi_tx[0] = NVT_SPI_WRITE(addr);
+	if (len)
+		memcpy(spi_tx + 1, data, len);
+	return touch_spi_xfer(spi_tx, NULL, len + 1u);
+}
+
+static int
+nvt_set_page(uint32_t addr)
+{
+	uint8_t page[3] = { 0xffu, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) };
+	return touch_spi_xfer(page, NULL, sizeof(page));
+}
+
+static int
+nvt_write_addr(uint32_t addr, uint8_t value)
+{
+	if (nvt_set_page(addr) != 0)
+		return EIO;
+	return nvt_write_raw(addr, &value, 1);
+}
+
+/* Vendor init order: GPIO8 starts low, ENG_RST is sent, then GPIO8 goes high. */
+static int
+nvt_hardware_reset(void)
+{
+	if (nvt_write_addr(NVT_ENG_RST_ADDR, 0x5au) != 0)
+		return EIO;
+	touch_gpio_output(SURYA_TOUCH_RESET_GPIO, true);
+	touch_wait_ms(10);
+	return 0;
+}
+
+static int
+nvt_read(uint32_t addr, uint8_t *out, size_t len)
+{
+	if (!out || len + 1u > sizeof(spi_tx) || nvt_set_page(addr) != 0)
+		return EIO;
+	memset(spi_tx, 0, len + 1u);
+	spi_tx[0] = NVT_SPI_READ(addr);
+	if (touch_spi_xfer(spi_tx, spi_rx, len + 1u) != 0)
+		return EIO;
+	/* Xiaomi's CTP_SPI_READ returns the first data byte at buffer[1]. */
+	memcpy(out, spi_rx + 1, len);
+	return 0;
+}
+
+static bool
+nvt_surya_trim_supported(const uint8_t id[NVT_TRIM_ID_LEN])
+{
+	if ((id[0] != 0x0au && id[0] != 0x0bu) || id[5] != 0x03u)
+		return false;
+	return ((id[3] == 0x72u && (id[4] == 0x65u || id[4] == 0x66u || id[4] == 0x67u)) ||
+	    (id[3] == 0x82u && id[4] == 0x66u) ||
+	    (id[3] == 0x25u && id[4] == 0x65u) ||
+	    (id[3] == 0x70u && id[4] == 0x66u));
+}
+
+static int
+nvt_probe_trim(uint8_t id[NVT_TRIM_ID_LEN])
+{
+	int err = nvt_write_addr(NVT_SWRST_N8_ADDR, 0x69u);
+	if (err)
+		return err;
+	touch_wait_ms(5);
+	if (nvt_write_addr(NVT_SPI_RD_FAST_ADDR, 0) != 0)
+		return EIO;
+	return nvt_read(NVT_TRIM_ID_ADDR, id, NVT_TRIM_ID_LEN);
+}
+
+static uint32_t
+nvt_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static size_t
+nvt_find_image_size(const uint8_t *fw, size_t size)
+{
+	for (size_t n = size / NVT_FW_SECTOR; n > 0; --n) {
+		const uint8_t *end = fw + n * NVT_FW_SECTOR - 3u;
+		if ((end[0] == 'N' && end[1] == 'V' && end[2] == 'T') ||
+		    (end[0] == 'M' && end[1] == 'O' && end[2] == 'D'))
+			return n * NVT_FW_SECTOR;
+	}
+	return 0;
+}
+
+/* Parser for the Xiaomi NT36xxx host-download header, with strict bounds. */
+static bool
+nvt_parse_firmware(const uint8_t *fw, size_t size)
+{
+	uint32_t header_end;
+	unsigned info_count = 0;
+	unsigned overlay_count;
+	if (!fw || size < NVT_FW_SECTOR || size > NVT_FW_MAX_SIZE)
+		return false;
+	fw_image_size = nvt_find_image_size(fw, size);
+	if (!fw_image_size || fw_image_size < 0x100u)
+		return false;
+	uint8_t version = fw[fw_image_size - NVT_FW_SECTOR];
+	uint8_t version_bar = fw[fw_image_size - NVT_FW_SECTOR + 1u];
+	if ((uint8_t)(version + version_bar) != 0xffu)
+		return false;
+	header_end = nvt_le32(fw);
+	if (header_end < 0x30u || header_end > fw_image_size ||
+	    ((header_end - 0x30u) & 0x0fu))
+		return false;
+	for (uint32_t pos = 0x30u; pos < header_end; pos += 0x10u) {
+		if (pos + 0x10u > fw_image_size)
+			return false;
+		info_count++;
+	}
+	overlay_count = (fw[0x28] & 0x10u) ? (fw[0x28] & 0x0fu) : 0u;
+	fw_nparts = 2u + info_count + overlay_count;
+	if (fw_nparts > NVT_MAX_PARTITIONS)
+		return false;
+	memset(fw_parts, 0, sizeof(fw_parts));
+	for (unsigned i = 0; i < fw_nparts; ++i) {
+		struct nvt_partition *p = &fw_parts[i];
+		if (i < 2u) {
+			p->bin = nvt_le32(fw + i * 12u);
+			p->sram = nvt_le32(fw + i * 12u + 4u);
+			p->size = nvt_le32(fw + i * 12u + 8u);
+			p->crc = nvt_le32(fw + 0x18u + i * 4u);
+		} else {
+			uint64_t pos64;
+			if (i < 2u + info_count) {
+				pos64 = 0x30u + 0x10u * (i - 2u);
+			} else {
+				pos64 = (uint64_t)fw_parts[1].bin +
+				    0x10u * (i - 2u - info_count);
+			}
+			if (pos64 > fw_image_size || fw_image_size - (size_t)pos64 < 16u)
+				return false;
+			uint32_t pos = (uint32_t)pos64;
+			p->sram = nvt_le32(fw + pos);
+			p->size = nvt_le32(fw + pos + 4u);
+			p->bin = nvt_le32(fw + pos + 8u);
+			p->crc = nvt_le32(fw + pos + 12u);
+		}
+		if (p->bin > fw_image_size ||
+		    (p->size && ((uint64_t)p->bin + (uint64_t)p->size + 1u > fw_image_size ||
+		    (uint64_t)p->sram + (uint64_t)p->size + 1u > 0x01000000u)))
+			return false;
+	}
+	printf("SWEET SURYA TOUCH: firmware %u bytes, image %u, %u partitions, version %#x\n",
+	    (unsigned)size, (unsigned)fw_image_size, fw_nparts, version);
+	return true;
+}
+
+static int
+nvt_write_partition(const uint8_t *fw, const struct nvt_partition *p)
+{
+	uint32_t done = 0;
+	uint32_t total = p->size + 1u;
+	while (done < total) {
+		uint32_t n = total - done;
+		if (n > NVT_FW_CHUNK)
+			n = NVT_FW_CHUNK;
+		uint32_t addr = p->sram + done;
+		if (nvt_set_page(addr) != 0)
+			return EIO;
+		fw_chunk[0] = NVT_SPI_WRITE(addr);
+		memcpy(fw_chunk + 1, fw + p->bin + done, n);
+		if (touch_spi_xfer(fw_chunk, NULL, n + 1u) != 0)
+			return EIO;
+		done += n;
+	}
+	return 0;
+}
+
+static int
+nvt_set_crc_bank(uint32_t des, uint32_t sram, uint32_t len_addr,
+    uint32_t len, uint32_t crc_addr, uint32_t crc)
+{
+	uint8_t b[4];
+	if (nvt_set_page(des) != 0)
+		return EIO;
+	b[0] = (uint8_t)sram;
+	b[1] = (uint8_t)(sram >> 8);
+	b[2] = (uint8_t)(sram >> 16);
+	if (nvt_write_raw(des, b, 3) != 0)
+		return EIO;
+	/* NT36672A/C hw_crc=1 uses a 16-bit length register. */
+	if (len > 0xffffu)
+		return EINVAL;
+	b[0] = (uint8_t)len;
+	b[1] = (uint8_t)(len >> 8);
+	if (nvt_write_raw(len_addr, b, 2) != 0)
+		return EIO;
+	b[0] = (uint8_t)crc;
+	b[1] = (uint8_t)(crc >> 8);
+	b[2] = (uint8_t)(crc >> 16);
+	b[3] = (uint8_t)(crc >> 24);
+	return nvt_write_raw(crc_addr, b, sizeof(b));
+}
+
+static bool
+nvt_firmware_from_adt(const uint8_t **fw, size_t *size)
+{
+	DTEntry node;
+	const void *data = NULL;
+	unsigned int n = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-touch", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "firmware", &data, &n) != kSuccess ||
+	    data == NULL || n < NVT_FW_SECTOR) {
+		printf("SWEET SURYA TOUCH: missing /sweet-touch firmware; use mkadt.py --touch-fw FILE\n");
+		return false;
+	}
+	*fw = data;
+	*size = n;
+	return true;
+}
+
+/* Firmware download is to volatile controller SRAM (the NT36672C is flashless). */
+static bool
+nvt_download_firmware(void)
+{
+	const uint8_t *fw = NULL;
+	size_t size = 0;
+	if (!nvt_firmware_from_adt(&fw, &size) || !nvt_parse_firmware(fw, size)) {
+		printf("SWEET SURYA TOUCH: invalid/missing Tianma firmware; touch stopped\n");
+		return false;
+	}
+	for (unsigned attempt = 1; attempt <= 3; ++attempt) {
+		if (nvt_write_addr(NVT_SWRST_N8_ADDR, 0x69u) != 0)
+			continue;
+		touch_wait_ms(5);
+		if (nvt_write_addr(NVT_SPI_RD_FAST_ADDR, 0) != 0)
+			continue;
+		bool ok = true;
+		for (unsigned i = 0; i < fw_nparts && ok; ++i) {
+			if (fw_parts[i].size)
+				ok = nvt_write_partition(fw, &fw_parts[i]) == 0;
+		}
+		if (!ok) {
+			printf("SWEET SURYA TOUCH: SRAM transfer failed on attempt %u\n", attempt);
+			continue;
+		}
+		if (nvt_set_crc_bank(NVT_ILM_DES_ADDR, fw_parts[0].sram,
+		    NVT_ILM_LENGTH_ADDR, fw_parts[0].size, NVT_ILM_GCRC_ADDR,
+		    fw_parts[0].crc) != 0 ||
+		    nvt_set_crc_bank(NVT_DLM_DES_ADDR, fw_parts[1].sram,
+		    NVT_DLM_LENGTH_ADDR, fw_parts[1].size, NVT_DLM_GCRC_ADDR,
+		    fw_parts[1].crc) != 0) {
+			printf("SWEET SURYA TOUCH: could not program ILM/DLM hardware CRC\n");
+			continue;
+		}
+		uint8_t old = 0;
+		if (nvt_read(NVT_BLD_CRC_EN_ADDR, &old, 1) != 0 ||
+		    nvt_write_addr(NVT_BLD_CRC_EN_ADDR, old | 0x80u) != 0 ||
+		    nvt_write_addr(NVT_EVENT_BUF_ADDR + NVT_EVENT_RESET, 0) != 0 ||
+		    nvt_write_addr(NVT_EVENT_BUF_ADDR + NVT_EVENT_HOST_CMD, 0xaeu) != 0 ||
+		    nvt_write_addr(NVT_BOOT_READY_ADDR, 1) != 0) {
+			printf("SWEET SURYA TOUCH: could not start firmware on attempt %u\n", attempt);
+			continue;
+		}
+		touch_wait_ms(5);
+		for (unsigned poll = 0; poll < 20; ++poll) {
+			uint8_t state = 0;
+			if (nvt_read(NVT_EVENT_BUF_ADDR + NVT_EVENT_RESET, &state, 1) == 0 &&
+			    state >= NVT_RESET_STATE_INIT && state <= NVT_RESET_STATE_MAX) {
+				printf("SWEET SURYA TOUCH: firmware running, reset state %#x (attempt %u)\n",
+				    state, attempt);
+				return true;
+			}
+			touch_wait_ms(10);
+		}
+		printf("SWEET SURYA TOUCH: firmware reset-state timeout on attempt %u\n", attempt);
+	}
+	return false;
+}
+
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned i = 0; i < SURYA_TOUCH_FINGERS; ++i) {
+		bool down = (mask & (1u << i)) != 0;
+		bool was_down = (st.active_mask & (1u << i)) != 0;
+		int old_x = st.x[i], old_y = st.y[i];
+		if (down != was_down ||
+		    (down && (x[i] != st.x[i] || y[i] != st.y[i])))
+			sweet_hid_touch((int)i, down, down ? x[i] : old_x, down ? y[i] : old_y);
+		if (down) {
+			st.x[i] = x[i];
+			st.y[i] = y[i];
+		}
+	}
+	st.active_mask = mask;
+}
+
+static int
+nvt_read_report(void)
+{
+	uint8_t report[NVT_REPORT_BYTES];
+	int x[SURYA_TOUCH_FINGERS] = { 0 };
+	int y[SURYA_TOUCH_FINGERS] = { 0 };
+	uint32_t mask = 0;
+	if (nvt_read(NVT_EVENT_BUF_ADDR, report, sizeof(report)) != 0)
+		return EIO;
+	for (unsigned slot = 0; slot < SURYA_TOUCH_FINGERS; ++slot) {
+		const uint8_t *p = report + slot * 6u;
+		unsigned id = p[0] >> 3;
+		unsigned state = p[0] & 7u;
+		if (id == 0 || id > SURYA_TOUCH_FINGERS || (state != 1u && state != 2u))
+			continue;
+		unsigned px = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		unsigned py = ((unsigned)p[2] << 4) | (p[3] & 0x0fu);
+		if (px >= SURYA_TOUCH_WIDTH || py >= SURYA_TOUCH_HEIGHT)
+			return EIO;
+		unsigned index = id - 1u;
+		if (mask & (1u << index))
+			return EIO;
+		mask |= 1u << index;
+		x[index] = (int)px;
+		y[index] = (int)py;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static void
+surya_touch_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	unsigned delay_s = 20;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	if (delay_s > 300)
+		delay_s = 300;
+	printf("SWEET SURYA TOUCH: stage %u starting in %u s\n", st.stage, delay_s);
+	touch_wait_ms(delay_s * 1000u);
+	st.tlmm = ml_io_map(SURYA_TOUCH_TLMM_PA, SURYA_TOUCH_TLMM_SIZE);
+	if (!st.tlmm) {
+		printf("SWEET SURYA TOUCH: TLMM mapping failed\n");
+		goto out;
+	}
+	touch_dump_pins();
+	if (st.stage == 1)
+		goto out;
+	st.se = ml_io_map(SURYA_TOUCH_SE_PA, SURYA_TOUCH_SE_SIZE);
+	st.gcc = ml_io_map(SURYA_TOUCH_GCC_PA, SURYA_TOUCH_GCC_SIZE);
+	if (!st.se || !st.gcc) {
+		printf("SWEET SURYA TOUCH: SE0/GCC mapping failed\n");
+		goto out;
+	}
+	uint32_t fw = touch_rd(st.se, SE_GENI_FW_REVISION);
+	printf("SWEET SURYA TOUCH: SE0 fw=%#x protocol=%u status=%#x hw=%#x/%#x GCC-vote=%#x RCG=%#x cfg=%#x DFS=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_GENI_STATUS),
+	    touch_rd(st.se, SE_GENI_HW_PARAM_0), touch_rd(st.se, SE_GENI_HW_PARAM_1),
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, TOUCH_GCC_SE0_RCG),
+	    touch_rd(st.gcc, TOUCH_GCC_SE0_RCG + 4u), touch_rd(st.gcc, TOUCH_GCC_SE0_RCG + 0x14u));
+	if (st.stage == 2)
+		goto out;
+	if (((fw >> 8) & 0xffu) != 0 && ((fw >> 8) & 0xffu) != SE_PROTO_SPI) {
+		printf("SWEET SURYA TOUCH: SE0 protocol %u is not SPI; no clock or pin changes\n",
+		    (fw >> 8) & 0xffu);
+		goto out;
+	}
+	if (touch_gcc_enable() != 0)
+		goto out;
+	fw = touch_rd(st.se, SE_GENI_FW_REVISION);
+	if (((fw >> 8) & 0xffu) != SE_PROTO_SPI ||
+	    (touch_rd(st.se, SE_GENI_IF_FIFO_DISABLE) & 1u)) {
+		printf("SWEET SURYA TOUCH: QUP0 SE0 is not a FIFO SPI endpoint; no pin changes\n");
+		goto out;
+	}
+	if (touch_rd(st.se, SE_GENI_STATUS) & 1u) {
+		printf("SWEET SURYA TOUCH: QUP0 SE0 became busy; no pin changes\n");
+		goto out;
+	}
+	int rail = sweet_rpmh_vreg_set("ldoa18", 3000, true);
+	printf("SWEET SURYA TOUCH: shared PM6150 L18A 3.0 V rail -> %d\n", rail);
+	if (rail != 0)
+		goto out;
+	touch_gpio_prepare();
+	touch_spi_pins();
+	if (!touch_spi_init())
+		goto out;
+	if (st.stage == 3)
+		goto out;
+	if (st.stage < 4)
+		goto out;
+	uint8_t trim[NVT_TRIM_ID_LEN] = { 0 };
+	if (nvt_hardware_reset() != 0) {
+		printf("SWEET SURYA TOUCH: hardware reset sequence failed\n");
+		goto out;
+	}
+	if (nvt_probe_trim(trim) != 0) {
+		printf("SWEET SURYA TOUCH: trim ID read failed\n");
+		goto out;
+	}
+	printf("SWEET SURYA TOUCH: trim ID %02x %02x %02x %02x %02x %02x\n",
+	    trim[0], trim[1], trim[2], trim[3], trim[4], trim[5]);
+	if (!nvt_surya_trim_supported(trim)) {
+		printf("SWEET SURYA TOUCH: chip trim is outside the NT36672C map; no firmware write\n");
+		goto out;
+	}
+	if (st.stage == 4)
+		goto out;
+	if (st.stage < 5)
+		goto out;
+	int download = 0;
+	(void)PE_parse_boot_argn("sweettouchfw", &download, sizeof(download));
+	if (!download) {
+		printf("SWEET SURYA TOUCH: firmware download skipped; pass sweettouchfw=1 at stage 5\n");
+		goto out;
+	}
+	if (!nvt_download_firmware()) {
+		printf("SWEET SURYA TOUCH: firmware did not start; report loop withheld\n");
+		goto out;
+	}
+	printf("SWEET SURYA TOUCH: polling 10-finger reports at 10 ms\n");
+	unsigned errors = 0;
+	while (!st.dead) {
+		int err = nvt_read_report();
+		if (err) {
+			if (++errors == 10) {
+				int zero[SURYA_TOUCH_FINGERS] = { 0 };
+				touch_report(0, zero, zero);
+			}
+			if ((errors % 100u) == 1u)
+				printf("SWEET SURYA TOUCH: report read error %d (%u)\n", err, errors);
+		} else {
+			errors = 0;
+		}
+		touch_wait_ms(10);
+	}
+out:
+	if (st.active_mask) {
+		int zero[SURYA_TOUCH_FINGERS] = { 0 };
+		touch_report(0, zero, zero);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_surya_touch_init(void)
+{
+	thread_t thread = NULL;
+	int enabled = 0;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	if (!sweet_board_surya() || !enabled) {
+		printf("SWEET SURYA TOUCH: disabled (set sweettouch=1 for staged bring-up)\n");
+		return;
+	}
+	if (st.started)
+		return;
+	st.started = true;
+	st.stage = 1;
+	(void)PE_parse_boot_argn("sweettouchstage", &st.stage, sizeof(st.stage));
+	if (st.stage < 1 || st.stage > 5) {
+		printf("SWEET SURYA TOUCH: stage %u outside 1..5; using read-only stage 1\n", st.stage);
+		st.stage = 1;
+	}
+	kern_return_t kr = kernel_thread_start(surya_touch_thread, NULL, &thread);
+	if (kr != KERN_SUCCESS) {
+		st.started = false;
+		printf("SWEET SURYA TOUCH: thread start failed (%d)\n", kr);
+		return;
+	}
+	thread_deallocate(thread);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
